{
  "_meta": {
    "생성일": "2026-09-20",
    "생성자": "백엔드A",
    "기준_스키마": "server/schemas.py Policy (dev @ 609765a), docs/04-data-schema.md",
    "필드_수": 24,
    "정책_수": 27,
    "review_state": "unverified",
    "설명": "미검수 초안. 사용자가 정리한 정책 목록을 저장소 스키마로 변환한 것이다. 공고 원문을 열어 확인한 값이 아니다.",
    "규약": {
      "data_status": "이 파일에서 'recheck'는 '사람 검수 대기'를 뜻하는 로컬 관례다. policies.json으로 승격할 때 검수 결과에 따라 verified/closed/upcoming으로 다시 설정한다. 실수로 서비스에 들어가도 '재확인 필요' 배지가 붙어 fail-safe가 된다.",
      "source_url": "Policy.source_url은 HttpUrl 필수다. 못 찾은 정책은 null로 두었고, null인 행은 policies.json으로 승격할 수 없다.",
      "title": "공고 제목 원문이 아니라 사용자가 정리한 임시 이름이다. Task 3에서 공고 제목 그대로 교체한다.",
      "빈_값": "exceptions_text/benefit/raw_text는 str 타입이라 null이 아니라 빈 문자열을 쓴다. 나머지 미확인 값은 null 또는 빈 배열.",
      "extra_conditions": "'항목: 필요한 값' 형식. 항목은 docs/01-glossary-profile.md 3장 추가 항목 표에 있는 것만 사용했다."
    },
    "승격_조건": [
      "source_url을 열어 공고 원문이 보인다",
      "title을 공고 제목 그대로 교체했다",
      "checked_at에 사람이 확인한 날짜를 넣었다",
      "raw_text에 자격·제외 대상·접수 기간 단락을 원문 그대로 복사했다",
      "condition_sources의 문장이 raw_text 안에 그대로 있고 각 10자 이상 150자 이하다",
      "apply_start/apply_end를 실제 날짜로 채웠다 (상시 접수면 apply_end만 null)",
      "data_status를 verified/closed/upcoming 중 하나로 다시 설정했다"
    ],
    "확인_필요": {
      "기간_모집이나_날짜_미확인": [
        "GOV-001", "GOV-002", "SEOUL-001", "SEOUL-002", "SEOUL-003", "SEOUL-004",
        "SEOUL-006", "SEOUL-007", "SEOUL-009", "SEOUL-010", "SEOUL-012", "SEOUL-013",
        "GOV-008", "GOV-009", "GOV-010", "GOV-011"
      ],
      "날짜_미확인_주의": "apply_end가 null이면 규칙 엔진이 '상시 접수'로 판정한다. 위 16건은 기간 모집이므로 날짜를 채우기 전에 승격하면 잘못된 배지가 뜬다.",
      "exceptions_text_필수": {
        "대상": ["GOV-001", "GOV-002", "SEOUL-013", "SEOUL-014", "SEOUL-015", "GOV-012"],
        "이유": "소득 기준이 기준 중위소득 %가 아니어서 income_max_pct를 비웠다. exceptions_text가 비면 소득 조건이 아예 사라져 소득 초과자에게 likely가 뜬다. 원문 문장을 반드시 채워야 한다."
      },
      "agency_미확인": ["GOV-008", "GOV-009", "GOV-010", "GOV-011"],
      "statuses_보수적_설정": {
        "대상": ["GOV-001", "GOV-002", "GOV-008", "GOV-009", "GOV-010", "GOV-011"],
        "이유": "원 목록이 '대학생' 또는 '제한 없음/대학생/구직자'로 모호했다. 과대 포함은 잘못된 met을 만들므로 좁게 잡았다. 원문 확인 후 조정하고, 휴학 포함 여부가 불분명한 문장은 exceptions_text로 옮긴다."
      },
      "상시_접수_11건": [
        "GOV-003", "GOV-004", "GOV-005", "GOV-006", "GOV-007", "GOV-012",
        "SEOUL-005", "SEOUL-008", "SEOUL-011", "SEOUL-014", "SEOUL-015"
      ],
      "데이터_조건_경고": "'9/20 기준 접수 중·상시 15건 이상' 목표에 상시 11건뿐이다. Task 3에서 기간 모집 16건 중 최소 4건이 9/20에 접수 중인지 확인해야 한다."
    }
  },
