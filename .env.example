# Comma-separated exact origins. Wildcards and URL paths are rejected.
CORS_LOCALHOST_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Set this to the deployed S3 website origin. Leave blank until assigned.
CORS_S3_ORIGINS=

# Non-secret adapter identifier only. Keep API keys in separate runtime secrets.
LLM_ADAPTER=

# Inactivity TTL for process-local sessions (30 minutes by default).
SESSION_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# AI model access (ai/adapters.py, ai/runtime.py, ai/judgment/client.py)
#
# Set both of the two below and the AI runs. Leave either blank and the AI is
# skipped: exception conditions stay unknown, the answer is replaced by its
# fallback message, and rule-based cards still render. No exception is raised.
# Check `ai.runtime.for_turn().missing` first when the model is not being called.
#
# Never commit real keys. Put them in your local shell environment only.
# ---------------------------------------------------------------------------

# Anthropic API key. ANTHROPIC_API_KEY is also accepted as a fallback name.
CLAUDE_API_KEY=

# Exact model name handed out at the camp. There is no default on purpose:
# a made-up model name fails at runtime with a 404, and that failure looks
# identical to "the AI is broken" on screen.
CLAUDE_MODEL=

# Optional. Defaults live in ai/judgment/client.py.
CLAUDE_MAX_TOKENS=
CLAUDE_TEMPERATURE=
