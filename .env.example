# Comma-separated exact origins. Wildcards and URL paths are rejected.
CORS_LOCALHOST_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Set this to the deployed S3 website origin. Leave blank until assigned.
CORS_S3_ORIGINS=

# Non-secret adapter identifier only. Keep API keys in separate runtime secrets.
LLM_ADAPTER=

# Inactivity TTL for process-local sessions (30 minutes by default).
SESSION_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# AI model access (ai/gateway.py, ai/runtime.py)
#
# The camp hands out an OpenAI-compatible gateway, not an Anthropic key.
# Set the two required values below and the AI runs end to end: exception
# judgment (ai/judgment) and answer writing (ai/conversation) both go through
# the same gateway.
#
# Leave either blank and the AI is skipped rather than crashing: exception
# conditions stay unknown, the answer falls back to its failure message, and
# rule-based cards still render. No exception is raised. When the model is not
# being called, read `ai.runtime.for_turn().missing` first -- it names exactly
# which value is absent.
#
# Never commit real keys. Keep them in your local shell environment only.
#   PowerShell:  $env:API_KEY = "sk-..."
#   bash/zsh:    export API_KEY="sk-..."
# ---------------------------------------------------------------------------

# Required. The sk- value from the key CSV. These names are also accepted, in
# this order: LLM_API_KEY, CLAUDE_API_KEY, ANTHROPIC_API_KEY, KMUCT_LLM_API_KEY.
API_KEY=

# Required. Model alias, not a real model ID (e.g. bedrock-haiku). Only aliases
# approved on your application form resolve. There is no default on purpose:
# an unapproved alias returns 403, and on screen that failure is
# indistinguishable from "the AI is broken". Start with bedrock-haiku and move
# up if the output is weak. CLAUDE_MODEL and KMUCT_LLM_MODEL are also read.
LLM_MODEL=

# Optional. Defaults to the address in the camp guide (ai/gateway.py).
# TLS verification works against this host; do not disable it.
LLM_BASE_URL=

# Optional. Response token ceiling. Defaults live in ai/gateway.py.
LLM_MAX_TOKENS=

# List the aliases your key can actually call:
#   curl -s https://52.79.201.46/v1/models -H "Authorization: Bearer $API_KEY"
